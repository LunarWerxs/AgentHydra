# Copy to .env (gitignored) and fill in. Bun auto-loads .env at daemon startup.
# None of these are required for a normal run — every one has a sane default.

# Preferred API/UI port. The daemon hops to the next free port if this one's busy and
# records where it landed in ~/.agenthydra/runtime.json (see PORT_FIXED below to disable
# the hop).
# PORT=7787

# Loopback bind host for the daemon. Only 127.0.0.1, localhost, and ::1 are accepted: the API is
# deliberately passwordless and must never be exposed on a LAN interface.
# HOST=127.0.0.1

# Config dir override (holds runtime.json + the instance-identity cache).
# Default: ~/.agenthydra
# AGENTHYDRA_HOME=

# State dir override (sqlite db, per-run logs, caches). Source and packaged builds share this.
# Default: ~/.agenthydra/data
# AGENTHYDRA_DATA_DIR=

# sqlite db path override (queue/dispatch/scheduler/accounts state).
# Default: ~/.agenthydra/data/agenthydra.db
# AGENTHYDRA_DB=

# 1 = bind PORT exactly and skip the single-instance guard / port-hop machinery. Useful for
# CI or running two instances deliberately side by side.
# AGENTHYDRA_PORT_FIXED=1

# If set, POST /api/shutdown requires a matching x-agenthydra-shutdown-token header (the
# tray sets this itself when it starts the daemon).
# AGENTHYDRA_SHUTDOWN_TOKEN=

# Headless dispatch (queueing a run for `claude` to execute unattended) is permanently refused -
# see server/src/headless-policy.ts. There is no env var left that changes that, or that makes
# dispatch spawn anything, real or fake: AGENTHYDRA_FAKE and AGENTHYDRA_RUNNER_LAUNCH went with the
# detached-runner spawn path they only ever configured.

# Force the /api/desktop-install detection result (dev/testing the Instances-tab warning):
# msix-only = MSIX build only (warning shows) · none = nothing installed · ok = classic install.
# AGENTHYDRA_FAKE_DESKTOP_INSTALL=msix-only

# Override the Codex Desktop GUI executable used for managed desktop instances. The normal Windows
# Appx/MSIX and macOS application locations are auto-detected.
# AGENTHYDRA_CODEX_DESKTOP_PATH=

# Base URL / port the bundled MCP stdio server (server/src/mcp.ts) uses to reach the
# daemon, instead of reading it from the runtime pointer. AGENTHYDRA_URL wins if both are set.
# AGENTHYDRA_URL=http://127.0.0.1:7787
# AGENTHYDRA_PORT=7787

# 1 = enable the background auto-update loop (git pull --ff-only + reinstall/rebuild +
# self-relaunch on a timer). Off by default; a dirty working tree is never touched.
# AGENTHYDRA_RELAUNCH is set internally by the daemon when it spawns its own successor
# process after an applied update — you shouldn't need to set it by hand.
# AGENTHYDRA_RELAUNCH=
