{
  "name": "hydra-desk",
  "//": "Hydra Desk 2: Michael's copy of ../desk (2026-10-04). Same packages, so the lockfile is desk's.",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun --watch server/src/index.ts",
    "dev:web": "bun run --cwd web dev",
    "start": "bun server/src/index.ts",
    "build": "bun run --cwd web build",
    "typecheck": "bun run --cwd server typecheck && bun run --cwd web typecheck",
    "test": "bun test ./server/test ./web/test",
    "e2e:engine": "bun e2e/engine.e2e.ts",
    "e2e:hosts": "bun e2e/hosts.e2e.ts"
  }
}
