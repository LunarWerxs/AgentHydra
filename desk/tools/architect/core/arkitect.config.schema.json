{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arkitect.config.schema.json",
  "title": "Arkitect Audit Configuration",
  "description": "Configuration schema for the Arkitect audit system.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this JSON Schema for IDE validation."
    },
    "version": {
      "type": "number",
      "description": "Optional config schema/version marker for policy packs."
    },
    "project": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "root": { "type": "string" },
            "languages": {
              "type": "array",
              "items": { "type": "string" }
            },
            "frameworks": {
              "type": "array",
              "items": { "type": "string" }
            },
            "ecosystems": {
              "type": "array",
              "items": { "type": "string" }
            },
            "detectRoots": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["name"]
        }
      ],
      "description": "Project metadata."
    },
    "paths": {
      "type": "object",
      "description": "File system paths used by audit checks.",
      "additionalProperties": false,
      "properties": {
        "uiPackageRoot": { "type": "string" },
        "sharedComponentRoots": {
          "type": "array",
          "items": { "type": "string" }
        },
        "publicComponentRoots": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lambdaSourceRoots": {
          "type": "array",
          "items": { "type": "string" }
        },
        "routeFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "migrationDirs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tokenFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sharedDeclarationFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "viewportDocuments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "workspaceViewportContractFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "testFilePattern": { "type": "string" },
        "entryPoints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sourceRoots": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "roots": {
      "type": "object",
      "description": "Named root groups for reusable policy packs.",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "description": "Output defaults shared by checks.",
      "additionalProperties": true
    },
    "suite": {
      "type": "object",
      "description": "Suite selection behavior. `configured` runs only checks named in groups/checks during --all.",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["discovered", "configured"]
        }
      }
    },
    "suiteMode": {
      "type": "string",
      "enum": ["discovered", "configured"],
      "description": "Legacy shorthand for suite.mode."
    },
    "dynamicChecks": {
      "type": "array",
      "description": "Additional check ids that need browser/dev-server/live-data setup and should be skipped by --all.",
      "items": { "type": "string" }
    },
    "groups": {
      "type": "object",
      "description": "Audit check groups. Each group maps a group name to its check list.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "checks": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["checks"]
      }
    },
    "checks": {
      "type": "object",
      "description": "Per-check configuration overrides. Each key is a check ID; values are check-specific options.",
      "additionalProperties": {
        "type": "object"
      }
    },
    "screenshots": {
      "type": "object",
      "description": "Screenshot audit configuration.",
      "additionalProperties": false,
      "properties": {
        "baseUrl": { "type": "string", "format": "uri" },
        "scenarios": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": { "type": "string" },
              "url": { "type": "string" },
              "viewport": {
                "type": "object",
                "properties": {
                  "width": { "type": "number" },
                  "height": { "type": "number" },
                  "deviceScaleFactor": { "type": "number" }
                },
                "required": ["width", "height"]
              }
            },
            "required": ["kind", "url"]
          }
        }
      },
      "required": ["baseUrl"]
    },
    "augments": {
      "type": "array",
      "description": "Optional array of augment config file paths to merge.",
      "items": { "type": "string" }
    },
    "projectDetection": {
      "type": "object",
      "description": "Filesystem roots used for language/framework detection.",
      "additionalProperties": false,
      "properties": {
        "roots": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "actionableArrayKeys": {
      "type": "array",
      "items": { "type": "string" }
    },
    "actionableCountKeys": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["project"]
}
