# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output ────────────────────────────────────────────────────────────
dist/
build/
out/
web/dist/
*.tsbuildinfo

# ── Caches ──────────────────────────────────────────────────────────────────
.cache/
.temp/
.turbo/
.vite/
.eslintcache
.stylelintcache

# ── Package-manager / runtime debug logs ────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*

# ── Tests / coverage ────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Env / secrets (NEVER commit) ────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ── Runtime / scratch ───────────────────────────────────────────────────────
tmp/
*.pid
*.seed
*.local

# ── Windows shortcuts (regenerated by misc/Create-Shortcut.ps1) ─────────────
*.lnk

# ── Editors / IDEs ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ── OS cruft ────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Project-local tooling (audit profile + run archives, not tracked) ───────
.arkitect/
.claude/
.saydeploy/
.agents/

# Local root rebuild convenience wrapper (delegates to misc/rebuild_devwebui.bat)
/rebuild_devwebui.bat

# Local AI memory for this repo. Deliberately NOT published.
/.claude/memory/

# ⛔ PUBLIC REPO: the to-do list is not published (owner directive, 2026-08-29).
# These notes are the most candid writing in the repo - what is broken, what is half-built, what is
# waiting on a person - and Odin's Loki files them here automatically from chat history. The
# folder's own README stays tracked (it is already tracked, and it states the convention); only the
# items are ignored. Managed by public_todo_guard.py in the Odin repo.
/docs/todo/*
!/docs/todo/README.md
